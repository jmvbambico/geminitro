{
  "name": "geminitro",
  "version": "1.7.0",
  "description": "Gemini API proxy with key rotation — multi-agent coding proxy",
  "main": "server.js",
  "type": "commonjs",
  "bin": {
    "geminitro": "./bin/geminitro.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "cd dashboard && npm install && npm run build",
    "lint": "eslint . && cd dashboard && npm run lint",
    "lint:fix": "eslint . --fix && cd dashboard && npm run lint -- --fix",
    "format": "prettier --write \"**/*.{js,json,md}\" \"!public/**\" \"!dashboard/dist/**\" && cd dashboard && prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\" \"!public/**\" \"!dashboard/dist/**\" && cd dashboard && prettier --check \"src/**/*.{ts,tsx,css}\"",
    "audit": "npm audit --audit-level=moderate",
    "prepare": "husky",
    "test": "jest --forceExit"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "dashboard/src/**/*.{ts,tsx,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "gemini",
    "proxy",
    "opencode",
    "claude-code",
    "coding-agent",
    "key-rotation",
    "ai"
  ],
  "preferGlobal": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^8.3.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "morgan": "^1.10.1",
    "open": "^8.4.2",
    "opencode-antigravity-auth": "^1.6.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.13",
    "prettier": "^3.8.1"
  }
}
