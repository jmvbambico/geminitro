{
  "name": "geminitro",
  "version": "1.0.0",
  "description": "Gemini API proxy with key rotation — OpenCode plugin",
  "main": "server.js",
  "type": "commonjs",
  "bin": {
    "geminitro": "./bin/geminitro.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "cd dashboard && npm install && npm run build"
  },
  "keywords": [
