PORT=7536
PROXY_API_KEY=geminitro
AUTO_UPDATE=false

# Interface preference for geminitro start
# Leave empty to be asked each time, or set to "browser" or "terminal"
# to automatically use that interface whenever you run geminitro start
SETUP_METHOD=

GEMINITRO_VERBOSE_LOGGING=false

# OAuth credentials — required for Antigravity / Gemini CLI OAuth features.
# Get these from the OpenCode Antigravity plugin source:
#   https://github.com/NoeFabris/opencode-antigravity-auth → src/constants.ts
#   Copy ANTIGRAVITY_CLIENT_ID → OAUTH_CLIENT_ID
#   Copy ANTIGRAVITY_CLIENT_SECRET → OAUTH_CLIENT_SECRET
# Or create your own at https://console.cloud.google.com/apis/credentials
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
